{
  "name": "booking-platform",
  "version": "1.0.0",
  "description": "An example of a multi tenant application with Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack --port 4000",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --turbopack",
    "dev:fresh": "cross-env NODE_OPTIONS=--no-deprecation && pnpm seed && next dev --turbopack --port 4000",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:schema": "payload-graphql generate:schema",
    "generate:types": "payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "npm run payload migrate:fresh",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "biome check .",
    "tsc": "tsgo --project tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.1",
    "@js-temporal/polyfill": "0.5.1",
