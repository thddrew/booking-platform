{
  "name": "booking-platform",
  "version": "1.0.0",
  "description": "An example of a multi tenant application with Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "_dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack --port 4000",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --turbopack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation && pnpm seed && next dev --turbopack --port 4000",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:schema": "payload-graphql generate:schema",
    "generate:types": "payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "npm run payload migrate:fresh",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "biome check .",
    "tsc": "tsgo --project tsconfig.json"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.53.0",
    "@payloadcms/next": "3.53.0",
    "@payloadcms/plugin-multi-tenant": "3.53.0",
    "@payloadcms/richtext-lexical": "3.53.0",
    "@payloadcms/ui": "3.53.0",
    "cross-env": "^7.0.3",
    "dotenv": "^8.2.0",
    "graphql": "^16.9.0",
    "next": "15.5.0",
    "payload": "3.53.0",
    "qs-esm": "7.0.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "0.32.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@payloadcms/graphql": "latest",
    "@swc/core": "^1.6.13",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "tsx": "^4.16.2",
    "typescript": "5.5.2",
    "@typescript/native-preview": "7.0.0-dev.20250826.1"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
